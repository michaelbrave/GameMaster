{
  "name": "worldforge-client",
  "version": "0.1.0",
  "private": true,
  "description": "Worldforge Elm client (pinned Elm 0.19.1 toolchain).",
  "scripts": {
    "build": "elm make src/Main.elm --output=public/main.js",
    "check": "elm make src/Main.elm --output=/dev/null",
    "test": "elm-test",
    "format:check": "elm-format --validate src tests",
    "format:write": "elm-format --yes src tests"
  },
  "devDependencies": {
    "elm": "0.19.1-6",
    "elm-format": "^0.8.8",
    "elm-test": "0.19.1-revision15"
  }
}
