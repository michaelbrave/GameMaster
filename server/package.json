{
  "name": "worldforge-server",
  "version": "0.1.0",
  "private": true,
  "description": "Worldforge TypeScript modular-monolith server.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "node dist/src/infrastructure/migrate.js",
    "fixtures": "npm run build && node dist/src/fixtures/dumpFixtures.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build && node --test --test-timeout=240000 \"dist/test/unit/*.test.js\" \"dist/test/contracts/*.test.js\" \"dist/test/integration/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.1.0-beta.9",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2"
  }
}
