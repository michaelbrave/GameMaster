{
  "$id": "worldforge/history.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Play-view history response (paginated text log)",
  "type": "object",
  "required": ["entries", "total", "offset", "limit"],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "tick", "type", "location", "text"],
        "additionalProperties": false,
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "tick": { "type": "integer", "minimum": 0 },
          "type": { "type": "string" },
          "location": { "anyOf": [{ "type": "null" }, { "$ref": "common.json#/definitions/axial" }] },
          "text": { "type": "string" }
        }
      }
    },
    "total": { "type": "integer", "minimum": 0 },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1 }
  }
}
