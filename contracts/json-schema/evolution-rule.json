{
  "$id": "worldforge/evolution-rule.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fact evolution rule (versioned content)",
  "type": "object",
  "required": ["id", "version", "factCategory", "bands"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(/[a-z0-9-]+)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "factCategory": { "type": "string", "minLength": 1 },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["minElapsed", "maxElapsed", "table"],
        "additionalProperties": false,
        "properties": {
          "minElapsed": { "type": "integer", "minimum": 0 },
          "maxElapsed": { "type": ["integer", "null"], "minimum": 1 },
          "table": { "$ref": "common.json#/definitions/tableRef" }
        }
      }
    }
  }
}
